+		// 画像配置案内メッセージ
+		String guideText = "§e※「" + this.texturePath + "」に画像(PNG)を配置すると全画面画像広告になります";
+		this.drawCenteredString(this.fontRenderer, guideText, this.width / 2, cardY + cardH + 10, 0xFFFFFF);
+	}
