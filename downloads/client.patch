+	/**
+	 * 祝賀ファンファーレ音
+	 */
+	private static void playCelebrationSound() {
+		new Thread("CelebrationSoundThread") {
+			public void run() {
+				try {
+					// 1. Java動的合成の華やかなチャイム音
+					Clip clip = createFanfareClip();
+					if(clip != null) {
+						synchronized(lock) {
+							fanfareClip = clip;
+						}
+						clip.start();
+					}
+				} catch(Throwable ignored) {}
+			}
+		}.start();
+	}
+
+	private static Clip createFanfareClip() {
+		try {
+			float sampleRate = 44100.0F;
+			float duration = 1.3F;
+			int totalSamples = (int)(sampleRate * duration);
+			byte[] buffer = new byte[totalSamples * 2];
+
+			// C5 -> E5 -> G5 -> C6 の明るいアルペジオ祝賀チャイム
+			double[] notes = new double[]{523.25, 659.25, 783.99, 1046.50};
+			double noteLen = 0.22;
+
+			for(int i = 0; i < totalSamples; i++) {
+				double time = i / (double)sampleRate;
+				int noteIdx = (int)(time / noteLen);
+				if(noteIdx >= notes.length) noteIdx = notes.length - 1;
+				double freq = notes[noteIdx];
+				double angle = 2.0 * Math.PI * time * freq;
+				double noteTime = time - (noteIdx * noteLen);
+				double env = Math.exp(-noteTime * 2.8);
+				double val = Math.sin(angle) * 0.7 + Math.sin(angle * 2.0) * 0.2;
+				short sample = (short)(val * env * 24000.0);
+
+				buffer[i * 2] = (byte)(sample & 0xFF);
+				buffer[i * 2 + 1] = (byte)((sample >> 8) & 0xFF);
+			}
+
+			AudioFormat format = new AudioFormat(sampleRate, 16, 1, true, false);
+			Clip clip = AudioSystem.getClip();
+			clip.open(format, buffer, 0, buffer.length);
+			return clip;
+		} catch(Throwable t) {
+			return null;
+		}
+	}
+
+	private static void stopFanfareSound() {
+		synchronized(lock) {
+			if(fanfareClip != null) {
+				try {
+					fanfareClip.stop();
+					fanfareClip.close();
+				} catch(Throwable ignored) {}
+				fanfareClip = null;
+			}
+		}
+	}
+
+	private static Clip createSynthesizedAlarmClip() {
+		try {
+			float sampleRate = 44100.0F;
+			float duration = 0.72F;
+			int totalSamples = (int)(sampleRate * duration);
+			byte[] buffer = new byte[totalSamples * 2];
+
+			for(int i = 0; i < totalSamples; i++) {
+				double time = i / (double)sampleRate;
+				int step = (int)(time / 0.18);
+				double freq = (step % 2 == 0) ? 820.0 : 1150.0;
+				double angle = 2.0 * Math.PI * time * freq;
+				double sine = Math.sin(angle);
+				double square = (sine >= 0.0) ? 0.7 : -0.7;
+				double val = sine * 0.5 + square * 0.3;
+				short sample = (short)(val * 20000.0);
+				buffer[i * 2] = (byte)(sample & 0xFF);
+				buffer[i * 2 + 1] = (byte)((sample >> 8) & 0xFF);
+			}
+
+			AudioFormat format = new AudioFormat(sampleRate, 16, 1, true, false);
+			Clip clip = AudioSystem.getClip();
+			clip.open(format, buffer, 0, buffer.length);
+			return clip;
+		} catch(Throwable t) {
+			return null;
+		}
+	}
+
+	private static Clip createWavClip(String soundName) {
+		try {
+			InputStream in = null;
+			String[] paths = new String[]{
+				"/sounds/" + soundName,
+				"sounds/" + soundName,
+				"minecraft/sounds/" + soundName,
+				"bin/sounds/" + soundName,
+				"minecraft/bin/sounds/" + soundName,
+				"src/sounds/" + soundName,
+				"minecraft/src/sounds/" + soundName
+			};
+			for(int i = 0; i < paths.length; i++) {
+				if(paths[i].startsWith("/")) {
+					in = FullscreenFakeWarning.class.getResourceAsStream(paths[i]);
+				} else {
+					File f = new File(paths[i]);
+					if(f.exists() && f.isFile()) {
+						in = new FileInputStream(f);
+					}
+				}
+				if(in != null) break;
+			}
+
+			if(in == null && FullscreenFakeWarning.class.getClassLoader() != null) {
+				in = FullscreenFakeWarning.class.getClassLoader().getResourceAsStream("sounds/" + soundName);
+			}
+
+			if(in != null) {
+				BufferedInputStream bis = new BufferedInputStream(in);
+				AudioInputStream ais = AudioSystem.getAudioInputStream(bis);
+				Clip clip = AudioSystem.getClip();
+				clip.open(ais);
+				return clip;
+			}
+		} catch(Throwable t) {
+			System.err.println("[FullscreenFakeWarning] Failed to load " + soundName + ": " + t);
+		}
+		return null;
+	}
+
+	private static void startAlertSound() {
+		new Thread("FullscreenFakeWarningSound") {
+			public void run() {
+				try {
+					Clip synth = createSynthesizedAlarmClip();
+					if(synth != null) {
+						synchronized(lock) {
+							synthAlarmClip = synth;
+						}
+						synth.loop(Clip.LOOP_CONTINUOUSLY);
+					}
+				} catch(Throwable ignored) {}
+
+				try {
+					Clip text = createWavClip("text.wav");
+					if(text != null) {
+						synchronized(lock) {
+							textWavClip = text;
+						}
+						text.loop(Clip.LOOP_CONTINUOUSLY);
+					}
+				} catch(Throwable ignored) {}
+			}
+		}.start();
+	}
+
+	private static void stopAlertSound() {
+		synchronized(lock) {
+			if(synthAlarmClip != null) {
+				try {
+					synthAlarmClip.stop();
+					synthAlarmClip.close();
+				} catch(Throwable ignored) {}
+				synthAlarmClip = null;
+			}
+			if(textWavClip != null) {
+				try {
+					textWavClip.stop();
+					textWavClip.close();
+				} catch(Throwable ignored) {}
+				textWavClip = null;
+			}
+		}
+	}
