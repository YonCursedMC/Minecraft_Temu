+	public static int adRemainingTicks = 0;
+	public static int totalAdTicks = 0;
+	private static int tickCounter = 0;
+	private static int marqueeX = 0;
+
+	private static final String[] HEADLINES = new String[]{
+		"⚡ TEMU 大感謝祭タイムセール ⚡ 全品99%OFF！ 今日だけ送料無料！",
+		"★ 億万長者気分でお買い物！ 制限時間まもなく終了！ ★",
+		"⚡ 衝撃価格！ 今すぐ注文して¥0ギフトを獲得しよう！ ⚡",
+		"★ 無料ルーレット開催中！ iPhone 15＆10万円クーポン当選！ ★"
+	};
+
+	private static final String[] MARQUEE_TEXTS = new String[]{
+		"★ 全国の皆様へ大還元！ 最高品質のTEMU正規品がすべて手に入る！ アプリを起動して無料ギフトを受け取ろう！ ★ 億万長者気分でお買い物！ ★",
+		"⚡ 【速報】在庫一掃処分セール！ バター・ダイヤ・装備品が信じられない超低価格！ 送料無料・即日配送！ ⚡",
+		"★ 5つ星レビュー99.9%！ 友達を招待して最大¥50,000キャッシュバック！ 今すぐチェック！ ★"
+	};
+
+	public static void startAd(int durationTicks) {
+		isAdActive = true;
+		adRemainingTicks = durationTicks;
+		totalAdTicks = durationTicks;
+		tickCounter = 0;
+		marqueeX = 0;
+
+		try {
+			int randSound = (new Random()).nextInt(4);
+			WavPlaySound.playsound("/sounds/buy" + randSound + ".wav");
+		} catch (Throwable t) {
+		}
+
+		TemuMusicPlayer.playAdAudio(1.0F);
+
+		Minecraft mc = Minecraft.getMinecraft();
+		if(mc != null && mc.thePlayer != null) {
+			mc.thePlayer.addChatMessage("§e[TEMU 広告] §c⚡ スポンサーCM放送中 ⚡");
+		}
+	}
+
+	public static void stopAd() {
+		if(!isAdActive) return;
+		isAdActive = false;
+		adRemainingTicks = 0;
+		TemuMusicPlayer.stopAdAudio();
+
+		Minecraft mc = Minecraft.getMinecraft();
+		if(mc != null && mc.thePlayer != null) {
+			mc.thePlayer.addChatMessage("§6[TEMU] §a広告を最後まで視聴しました！ (スキップ完了)");
+			mc.thePlayer.inventory.addItemStackToInventory(new ItemStack(Item.Butter, 1));
+		}
+	}
+
+	public static void updateTick() {
+		if(!isAdActive) return;
+		tickCounter++;
+		marqueeX += 2;
+		adRemainingTicks--;
+		if(adRemainingTicks <= 0) {
+			stopAd();
+		}
+	}
+
+	public static void render(Minecraft mc, int screenWidth, int screenHeight, FontRenderer fontRenderer) {
+		if(!isAdActive || mc.gameSettings.hideGUI) {
+			return;
+		}
+
+		int bannerHeight = 36;
+
+		GL11.glPushMatrix();
+		GL11.glEnable(GL11.GL_BLEND);
+		GL11.glBlendFunc(GL11.GL_SRC_ALPHA, GL11.GL_ONE_MINUS_SRC_ALPHA);
+		GL11.glDisable(GL11.GL_DEPTH_TEST);
+		GL11.glDepthMask(false);
+
+		// Dark banner background
+		Gui.drawRect(0, 0, screenWidth, bannerHeight, 0xEE161616);
+
+		// Flashing bottom border (TEMU orange & gold pulse)
+		int pulseColor = (tickCounter % 20 < 10) ? 0xFFFF5500 : 0xFFFFCC00;
+		Gui.drawRect(0, bannerHeight - 2, screenWidth, bannerHeight, pulseColor);
+
+		// TEMU Logo icon (top left)
+		int logoSize = 28;
+		int logoX = 4;
+		int logoY = 3;
+		GL11.glColor4f(1.0F, 1.0F, 1.0F, 1.0F);
+		try {
+			int tex = mc.renderEngine.getTexture("/temu/TEMU.png");
+			mc.renderEngine.bindTexture(tex);
+			Tessellator tess = Tessellator.instance;
+			tess.startDrawingQuads();
+			tess.addVertexWithUV(logoX, logoY + logoSize, 0.0D, 0.0D, 1.0D);
+			tess.addVertexWithUV(logoX + logoSize, logoY + logoSize, 0.0D, 1.0D, 1.0D);
+			tess.addVertexWithUV(logoX + logoSize, logoY, 0.0D, 1.0D, 0.0D);
+			tess.addVertexWithUV(logoX, logoY, 0.0D, 0.0D, 0.0D);
+			tess.draw();
+		} catch (Throwable t) {
+		}
+
+		// [広告/PR] badge
+		int badgeX = logoX + logoSize + 4;
+		Gui.drawRect(badgeX, 5, badgeX + 44, 17, 0xFFCC2200);
+		fontRenderer.drawStringWithShadow("広告/PR", badgeX + 3, 7, 0xFFFFFF);
+
+		// Headline text
+		int headlineIndex = (tickCounter / 80) % HEADLINES.length;
+		String headline = HEADLINES[headlineIndex];
+		fontRenderer.drawStringWithShadow(headline, badgeX + 48, 7, 0xFFFFDD00);
+
+		// Right countdown info
+		int secondsLeft = (adRemainingTicks + 19) / 20;
+		String countdownStr = "広告終了まで " + secondsLeft + "s";
+		int countW = fontRenderer.getStringWidth(countdownStr);
+		int countX = screenWidth - countW - 8;
+		Gui.drawRect(countX - 4, 4, screenWidth - 4, 18, 0x88000000);
+		fontRenderer.drawStringWithShadow(countdownStr, countX, 6, 0xCCCCCC);
+
+		// Fake CTA button
+		String ctaStr = "無料GET ❯";
+		int ctaW = fontRenderer.getStringWidth(ctaStr) + 12;
+		int ctaX = screenWidth - ctaW - 6;
+		int ctaY = 20;
+		int ctaColor = (tickCounter % 16 < 8) ? 0xFFFF6600 : 0xFFFF4400;
+		Gui.drawRect(ctaX, ctaY, ctaX + ctaW, ctaY + 13, ctaColor);
+		fontRenderer.drawStringWithShadow(ctaStr, ctaX + 6, ctaY + 3, 0xFFFFFF);
+
+		// Scrolling marquee text on line 2
+		int marqueeIndex = (tickCounter / 200) % MARQUEE_TEXTS.length;
+		String marqueeText = MARQUEE_TEXTS[marqueeIndex];
+		int marqueeWidth = fontRenderer.getStringWidth(marqueeText);
+		int availableWidth = ctaX - badgeX - 10;
+		if (availableWidth > 50) {
+			int scrollSpan = marqueeWidth + availableWidth;
+			int curOffset = (marqueeX % scrollSpan);
+			int textDrawX = ctaX - 10 - curOffset;
+			fontRenderer.drawStringWithShadow(marqueeText, textDrawX, 22, 0xFFFFFF);
+		}
+
+		GL11.glDepthMask(true);
+		GL11.glEnable(GL11.GL_DEPTH_TEST);
+		GL11.glDisable(GL11.GL_BLEND);
+		GL11.glPopMatrix();
+	}
+}
