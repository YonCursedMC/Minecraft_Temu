+			this.fontRenderer.drawString("§8" + pw.subText, pw.x + 8, pw.y + 40, 0x000000);
+
+			// 内蔵ボタン: [無料GET ❯]
+			int btnGetX = pw.x + 8;
+			int btnGetY = pw.y + pw.h - 22;
+			drawRect(btnGetX, btnGetY, btnGetX + 70, btnGetY + 16, 0xFFFF6600);
+			this.fontRenderer.drawStringWithShadow("今すぐGET", btnGetX + 10, btnGetY + 4, 0xFFFFFF);
+
+			// 内蔵ボタン: [閉じる]
+			int btnCloseX = pw.x + pw.w - 55;
+			int btnCloseY = pw.y + pw.h - 22;
+			boolean btnCloseHover = (mouseX >= btnCloseX && mouseX <= btnCloseX + 48 && mouseY >= btnCloseY && mouseY <= btnCloseY + 16);
+			drawRect(btnCloseX, btnCloseY, btnCloseX + 48, btnCloseY + 16, btnCloseHover ? 0xFFCCCCCC : 0xFFE0E0E0);
+			this.fontRenderer.drawString("閉じる", btnCloseX + 10, btnCloseY + 4, 0x222222);
+		}
+
+		super.drawScreen(mouseX, mouseY, partialTicks);
+	}
