+	private static void drawFakeCursor(Graphics2D g2, int cx, int cy, int scale) {
+		// カーソルのドロップシャドウ (+scale, +scale)
+		g2.setColor(new Color(0, 0, 0, 80));
+		for(int r = 0; r < CURSOR_PIXELS.length; r++) {
+			String line = CURSOR_PIXELS[r];
+			for(int c = 0; c < line.length(); c++) {
+				char ch = line.charAt(c);
+				if(ch == 'X' || ch == '.') {
+					g2.fillRect(cx + (c + 1) * scale, cy + (r + 1) * scale, scale, scale);
+				}
+			}
+		}
+
+		// カーソル本体 (X: 黒枠, .: 白塗り)
+		for(int r = 0; r < CURSOR_PIXELS.length; r++) {
+			String line = CURSOR_PIXELS[r];
+			for(int c = 0; c < line.length(); c++) {
+				char ch = line.charAt(c);
+				if(ch == 'X') {
+					g2.setColor(Color.BLACK);
+					g2.fillRect(cx + c * scale, cy + r * scale, scale, scale);
+				} else if(ch == '.') {
+					g2.setColor(Color.WHITE);
+					g2.fillRect(cx + c * scale, cy + r * scale, scale, scale);
+				}
+			}
+		}
+	}
