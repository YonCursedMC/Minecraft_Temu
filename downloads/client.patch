+
+		// 上部のプログレスバー (10秒間のスキップ待機ゲージ)
+		if(this.remainingTicks > 0) {
+			int barH = 4;
+			drawRect(0, 0, this.width, barH, 0x88000000);
+			float progress = (float)(this.totalDelayTicks - this.remainingTicks) / (float)this.totalDelayTicks;
+			int filledW = (int)(this.width * progress);
+			int barColor = (this.ticksElapsed % 10 < 5) ? 0xFFFF7700 : 0xFFFF5500;
+			drawRect(0, 0, filledW, barH, barColor);
+		}
+
+		// ボタン等の描画
+		super.drawScreen(mouseX, mouseY, partialTicks);
+	}
