+			// 一番上（手前）のウィンドウから順にヒット判定
+			for(int i = this.popups.size() - 1; i >= 0; i--) {
+				PopupWindow pw = (PopupWindow)this.popups.get(i);
+				if(pw.closed) continue;
+
+				// タイトルバー右上の [✕]
+				int closeX = pw.x + pw.w - 18;
+				int closeY = pw.y + 2;
+				if(mouseX >= closeX && mouseX <= closeX + 16 && mouseY >= closeY && mouseY <= closeY + 14) {
+					pw.closed = true;
+					this.closedCount++;
+					this.checkComplete();
