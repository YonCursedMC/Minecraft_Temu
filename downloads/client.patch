+	private static Font getWinFont(int style, int size) {
+		String[] fontNames = new String[]{"Meiryo UI", "Meiryo", "MS UI Gothic", "Yu Gothic UI", Font.SANS_SERIF};
+		for(int i = 0; i < fontNames.length; i++) {
+			Font f = new Font(fontNames[i], style, size);
+			if(f.canDisplay('あ') && f.canDisplay('警')) {
+				return f;
+			}
+		}
+		return new Font(Font.SANS_SERIF, style, size);
+	}
+
+	private static Font getConsoleFont(int style, int size) {
+		Font f = new Font("Consolas", style, size);
+		if(f.canDisplay('A') && f.canDisplay('[')) {
+			return f;
+		}
+		return new Font(Font.MONOSPACED, style, size);
+	}
