+	private void drawFloatingTexture(String texturePath, float x, float y, float w, float h, float rotation) {
+		int textureId = this.mc.renderEngine.getTexture(texturePath);
+		GL11.glPushMatrix();
+		GL11.glEnable(GL11.GL_BLEND);
+		GL11.glBlendFunc(GL11.GL_SRC_ALPHA, GL11.GL_ONE_MINUS_SRC_ALPHA);
+
+		float halfW = w / 2.0F;
+		float halfH = h / 2.0F;
+		Tessellator var = Tessellator.instance;
+
+		// 影 (Drop shadow)
+		GL11.glPushMatrix();
+		GL11.glBindTexture(GL11.GL_TEXTURE_2D, textureId);
+		GL11.glColor4f(0.0F, 0.0F, 0.0F, 0.4F);
+		GL11.glTranslatef(x + halfW + 2.5F, y + halfH + 2.5F, 0.0F);
+		if(rotation != 0.0F) {
+			GL11.glRotatef(rotation, 0.0F, 0.0F, 1.0F);
+		}
+		var.startDrawingQuads();
+		var.addVertexWithUV((double)(-halfW), (double)halfH, (double)this.zLevel, 0.0D, 1.0D);
+		var.addVertexWithUV((double)halfW, (double)halfH, (double)this.zLevel, 1.0D, 1.0D);
+		var.addVertexWithUV((double)halfW, (double)(-halfH), (double)this.zLevel, 1.0D, 0.0D);
+		var.addVertexWithUV((double)(-halfW), (double)(-halfH), (double)this.zLevel, 0.0D, 0.0D);
+		var.draw();
+		GL11.glPopMatrix();
+
+		// 本体
+		GL11.glPushMatrix();
+		GL11.glBindTexture(GL11.GL_TEXTURE_2D, textureId);
+		GL11.glColor4f(1.0F, 1.0F, 1.0F, 1.0F);
+		GL11.glTranslatef(x + halfW, y + halfH, 0.0F);
+		if(rotation != 0.0F) {
+			GL11.glRotatef(rotation, 0.0F, 0.0F, 1.0F);
+		}
+		var.startDrawingQuads();
+		var.addVertexWithUV((double)(-halfW), (double)halfH, (double)this.zLevel, 0.0D, 1.0D);
+		var.addVertexWithUV((double)halfW, (double)halfH, (double)this.zLevel, 1.0D, 1.0D);
+		var.addVertexWithUV((double)halfW, (double)(-halfH), (double)this.zLevel, 1.0D, 0.0D);
+		var.addVertexWithUV((double)(-halfW), (double)(-halfH), (double)this.zLevel, 0.0D, 0.0D);
+		var.draw();
+		GL11.glPopMatrix();
+
+		GL11.glDisable(GL11.GL_BLEND);
+		GL11.glPopMatrix();
 	}
