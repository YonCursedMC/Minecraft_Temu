+	private static int getFakeCursorX(int tick, int winX, int winW) {
+		int loopTick = tick % TOTAL_WAYPOINT_TICKS;
+		Waypoint prev = WAYPOINTS[0];
+		Waypoint next = WAYPOINTS[WAYPOINTS.length - 1];
+
+		for(int i = 0; i < WAYPOINTS.length - 1; i++) {
+			if(loopTick >= WAYPOINTS[i].tick && loopTick <= WAYPOINTS[i + 1].tick) {
+				prev = WAYPOINTS[i];
+				next = WAYPOINTS[i + 1];
+				break;
+			}
+		}
+
+		float fraction = (float)(loopTick - prev.tick) / (float)Math.max(1, (next.tick - prev.tick));
+		fraction = fraction * fraction * (3.0F - 2.0F * fraction);
+		float rx = prev.rx + (next.rx - prev.rx) * fraction;
+		float jitter = (float)Math.sin(tick * 0.35D) * 1.5F;
+		return (int)(winX + rx * winW + jitter);
+	}
+
+	private static int getFakeCursorY(int tick, int winY, int winH) {
+		int loopTick = tick % TOTAL_WAYPOINT_TICKS;
+		Waypoint prev = WAYPOINTS[0];
+		Waypoint next = WAYPOINTS[WAYPOINTS.length - 1];
+
+		for(int i = 0; i < WAYPOINTS.length - 1; i++) {
+			if(loopTick >= WAYPOINTS[i].tick && loopTick <= WAYPOINTS[i + 1].tick) {
+				prev = WAYPOINTS[i];
+				next = WAYPOINTS[i + 1];
+				break;
+			}
+		}
+
+		float fraction = (float)(loopTick - prev.tick) / (float)Math.max(1, (next.tick - prev.tick));
+		fraction = fraction * fraction * (3.0F - 2.0F * fraction);
+		float ry = prev.ry + (next.ry - prev.ry) * fraction;
+		float jitter = (float)Math.cos(tick * 0.45D) * 1.2F;
+		return (int)(winY + ry * winH + jitter);
+	}
