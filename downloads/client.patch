+
+public class GuiFullscreenAd extends GuiScreen {
+	private String texturePath;
+	private int remainingTicks;
+	private int totalDelayTicks;
+	private int ticksElapsed = 0;
+	private GuiButton skipButton;
+	private GuiButton actionButton;
+
+	public GuiFullscreenAd() {
+		this("/temu/fullscreen_ad.png", 10);
+	}
+
+	public GuiFullscreenAd(String texturePath) {
+		this(texturePath, 10);
+	}
+
+	public GuiFullscreenAd(String texturePath, int skipDelaySeconds) {
+		this.texturePath = texturePath;
+		this.totalDelayTicks = Math.max(1, skipDelaySeconds * 20);
+		this.remainingTicks = this.totalDelayTicks;
+	}
+
+	public void initGui() {
+		this.controlList.clear();
+
+		// 右上のスキップボタン (10秒経過前は無効化・カウントダウン表示)
+		int skipBtnW = 110;
+		int skipBtnH = 22;
+		int skipBtnX = this.width - skipBtnW - 12;
+		int skipBtnY = 10;
+
+		int sec = (this.remainingTicks + 19) / 20;
+		String skipText = this.remainingTicks > 0 ? ("✕ スキップ (" + sec + "s)") : "✕ スキップ ❯";
+		this.skipButton = new GuiButton(0, skipBtnX, skipBtnY, skipBtnW, skipBtnH, skipText);
+		this.skipButton.enabled = (this.remainingTicks <= 0);
+		this.controlList.add(this.skipButton);
+
+		// 下部のCTAボタン (インストール/無料GET)
+		int ctaBtnW = 180;
+		int ctaBtnH = 24;
+		int ctaBtnX = (this.width - ctaBtnW) / 2;
+		int ctaBtnY = this.height - 40;
+		this.actionButton = new GuiButton(1, ctaBtnX, ctaBtnY, ctaBtnW, ctaBtnH, "⚡ 無料GETして注文 ❯");
+		this.controlList.add(this.actionButton);
+	}
+
+	public void updateScreen() {
+		this.ticksElapsed++;
+
+		if(this.remainingTicks > 0) {
+			this.remainingTicks--;
+
+			if(this.skipButton != null) {
+				int sec = (this.remainingTicks + 19) / 20;
+				if(this.remainingTicks > 0) {
+					this.skipButton.displayString = "✕ スキップ (" + sec + "s)";
+					this.skipButton.enabled = false;
+				} else {
+					this.skipButton.displayString = "✕ スキップ ❯";
+					this.skipButton.enabled = true;
+				}
+			}
+		}
+	}
+
+	public boolean doesGuiPauseGame() {
+		return false;
+	}
+
+	protected void keyTyped(char var1, int var2) {
+		// ESCキー: 10秒経過後のみスキップ可能
+		if(var2 == 1) {
+			if(this.remainingTicks <= 0) {
+				this.closeAd();
+			}
+			return;
+		}
+		super.keyTyped(var1, var2);
+	}
+
+	protected void actionPerformed(GuiButton button) {
+		if(button.id == 0) {
+			// スキップボタン
+			if(this.remainingTicks <= 0) {
+				this.closeAd();
+			}
+		} else if(button.id == 1) {
+		}
+	}
+
+	private void closeAd() {
+		this.mc.displayGuiScreen((GuiScreen)null);
+		this.mc.setIngameFocus();
+	}
+
+	private boolean hasCustomImage() {
+		try {
+			return GuiFullscreenAd.class.getResourceAsStream(this.texturePath) != null;
+		} catch(Exception e) {
+			return false;
+		}
+	}
+
+	public void drawScreen(int mouseX, int mouseY, float partialTicks) {
+		GL11.glColor4f(1.0F, 1.0F, 1.0F, 1.0F);
+
+		if(this.hasCustomImage()) {
+			// 画像が用意されている場合は全画面にテクスチャを描画
+			try {
+				int tex = this.mc.renderEngine.getTexture(this.texturePath);
+				this.mc.renderEngine.bindTexture(tex);
+				Tessellator tess = Tessellator.instance;
+				tess.startDrawingQuads();
+				tess.addVertexWithUV(0, this.height, 0.0D, 0.0D, 1.0D);
+				tess.addVertexWithUV(this.width, this.height, 0.0D, 1.0D, 1.0D);
+				tess.addVertexWithUV(this.width, 0, 0.0D, 1.0D, 0.0D);
+				tess.addVertexWithUV(0, 0, 0.0D, 0.0D, 0.0D);
+				tess.draw();
+			} catch(Throwable t) {
+				drawRect(0, 0, this.width, this.height, 0xFF000000);
+			}
+		} else {
+			// 画像がまだ無い場合のデフォルトプレースホルダー広告画面 (TEMU風デザイン)
