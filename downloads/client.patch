+				int btnCloseY = pw.y + pw.h - 22;
+				if(mouseX >= btnCloseX && mouseX <= btnCloseX + 48 && mouseY >= btnCloseY && mouseY <= btnCloseY + 16) {
+					pw.closed = true;
+					this.closedCount++;
+					this.checkComplete();
+					try {
+						WavPlaySound.playsound("/sounds/click1.wav");
+					} catch(Throwable t) {
+					}
