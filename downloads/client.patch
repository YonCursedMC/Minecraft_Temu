+package net.minecraft.src;
+
+import net.minecraft.client.Minecraft;
+import org.lwjgl.opengl.GL11;
+
+public class WindowsToastOverlay {
+	private static boolean active = false;
+	private static String toastTitle = "Windows セキュリティ";
+	private static String toastSubtitle = "脅威がブロックされました";
+	private static String toastBody = "お使いのデバイスは保護されています。";
+	private static boolean isSuccess = true;
+	private static int animTick = 0;
+	private static final int TOTAL_TICKS = 120; // 6秒間表示
+
+	public static void show(String title, String subtitle, String body, boolean success) {
+		toastTitle = title;
+		toastSubtitle = subtitle;
+		toastBody = body;
+		isSuccess = success;
+		animTick = 0;
+		active = true;
+	}
+
+	public static void updateTick() {
+		if(!active) return;
+		animTick++;
+		if(animTick >= TOTAL_TICKS) {
+			active = false;
+		}
+	}
+
+	public static boolean isActive() {
+		return active;
+	}
+
+	public static void render(Minecraft mc, int screenWidth, int screenHeight, FontRenderer fontRenderer) {
+		if(!active || fontRenderer == null) {
+			return;
+		}
+
+		int toastW = 200;
+		int toastH = 56;
+
+		// スライドイン (最初の10tick) / スライドアウト (最後の10tick)
+		int slideOffset = 0;
+		if(animTick < 10) {
+			float t = (float)animTick / 10.0F;
+			slideOffset = (int)((1.0F - t) * (toastW + 20));
+		} else if(animTick > TOTAL_TICKS - 10) {
+			float t = (float)(TOTAL_TICKS - animTick) / 10.0F;
+			slideOffset = (int)((1.0F - t) * (toastW + 20));
+		}
+
+		int toastX = screenWidth - toastW - 10 + slideOffset;
+		int toastY = screenHeight - toastH - 10;
+
+		GL11.glPushMatrix();
+		GL11.glEnable(GL11.GL_BLEND);
+		GL11.glBlendFunc(GL11.GL_SRC_ALPHA, GL11.GL_ONE_MINUS_SRC_ALPHA);
+		GL11.glDisable(GL11.GL_DEPTH_TEST);
+		GL11.glDepthMask(false);
+
+		// ドロップシャドウ
+		Gui.drawRect(toastX + 3, toastY + 3, toastX + toastW + 3, toastY + toastH + 3, 0x60000000);
+
+		// トースト外枠 & 背景 (Windowsダークモード風)
+		Gui.drawRect(toastX - 1, toastY - 1, toastX + toastW + 1, toastY + toastH + 1, 0xFF3C3C3C);
+		Gui.drawRect(toastX, toastY, toastX + toastW, toastY + toastH, 0xF21F1F1F);
+
+		// 左端のアクセントカラー縦線 (成功なら青/緑、警告なら黄/赤)
+		int accentColor = isSuccess ? 0xFF0078D7 : 0xFFFFAA00;
+		Gui.drawRect(toastX, toastY, toastX + 3, toastY + toastH, accentColor);
+
+		// タイトル行: [盾アイコン] Windows セキュリティ  たった今
+		// 簡易盾アイコン描画
+		int iconX = toastX + 8;
+		int iconY = toastY + 6;
+		Gui.drawRect(iconX, iconY, iconX + 8, iconY + 9, accentColor);
+		Gui.drawRect(iconX + 1, iconY + 1, iconX + 7, iconY + 8, 0xFFFFFFFF);
+
+		fontRenderer.drawString(toastTitle, iconX + 12, toastY + 7, 0xCCCCCC);
+		fontRenderer.drawString("たった今", toastX + toastW - 40, toastY + 7, 0x777777);
+
+		// サブタイトル (太字風)
+		int subColor = isSuccess ? 0xFFFFFFFF : 0xFFFFCC66;
+		fontRenderer.drawString(toastSubtitle, toastX + 8, toastY + 21, subColor);
+
+		// 詳細文
+		fontRenderer.drawString(toastBody, toastX + 8, toastY + 36, 0x999999);
+
+		GL11.glDepthMask(true);
+		GL11.glEnable(GL11.GL_DEPTH_TEST);
+		GL11.glDisable(GL11.GL_BLEND);
+		GL11.glPopMatrix();
+	}
+}
